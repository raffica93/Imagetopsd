{
  "name": "frescolayers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts server/*.test.ts hosting/*.test.ts",
    "test:e2e": "npm run build && node tests/browser.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test:semantic": "npm run build && node tests/semantic-browser.mjs",
    "build:site": "npm run build && node scripts/build-site.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "ag-psd": "^34.1.0",
    "express": "^5.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
